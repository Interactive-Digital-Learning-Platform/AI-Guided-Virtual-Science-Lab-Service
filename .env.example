# Server
PORT=8005
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ai_science_lab?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Groq (OpenAI-compatible, free tier — hosts Llama/Mixtral, not xAI's Grok)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# CORS
ALLOWED_ORIGINS=http://localhost:3000,exp://localhost:8081

# Reverse-proxy hops in front of this service (see src/app.js). 1 = local nginx gateway.
# Behind Azure Container Apps ingress + the gateway this is higher — verify after deploying.
TRUST_PROXY=1

# Media storage — element/compound artwork (see src/services/mediaService.js).
# S3-compatible; point at the shared MinIO from Deployment-Infrastructure for local dev.
# Set MEDIA_PROVIDER=cloudinary/s3 later and the mobile app needs no change (it only gets a URL).
MEDIA_PROVIDER=minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=lab-media
MINIO_USE_SSL=false
# Leave unset for local MinIO. Set for a hosted S3-compatible store (deployment):
#   Cloudflare R2: MINIO_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  MINIO_REGION=auto
#   AWS S3:        MINIO_ENDPOINT=https://s3.<region>.amazonaws.com             MINIO_REGION=<region>
# Use keys scoped to this one bucket. Existing chemical records need no change — they store
# only the object key, so copying the bucket's objects across is enough, e.g. with MinIO's `mc`:
#   mc alias set local http://localhost:9000 <key> <secret>
#   mc alias set cloud <MINIO_ENDPOINT> <key> <secret>
#   mc mirror local/lab-media cloud/lab-media
# MINIO_REGION=
