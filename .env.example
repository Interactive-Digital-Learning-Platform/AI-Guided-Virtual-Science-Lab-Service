# Server
PORT=8005
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ai_science_lab?retryWrites=true&w=majority

# Clerk — POST /api/auth/sync only issues a backend JWT for a verified Clerk session token.
# Same Clerk instance as the mobile app. Authorized parties: optional exact web origins (native tokens omit azp).
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=
# Secret key of that same instance. Lets sync re-link an existing record to a new Clerk user id
# (account recreated, or moved between instances) once Clerk confirms the email is verified.
# Unset: such users keep getting 409 "This email is already linked to another account."
CLERK_SECRET_KEY=

# Proxies in front of the app that append X-Forwarded-For (1 = local nginx gateway; 3 on Azure Container Apps).
TRUST_PROXY_HOPS=1

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Groq (OpenAI-compatible, free tier — hosts Llama/Mixtral, not xAI's Grok)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# CORS
ALLOWED_ORIGINS=http://localhost:3000,exp://localhost:8081

# Media storage — element/compound artwork (see src/services/mediaService.js).
# S3-compatible; point at the shared MinIO from Deployment-Infrastructure for local dev.
# Set MEDIA_PROVIDER=cloudinary/s3 later and the mobile app needs no change (it only gets a URL).
MEDIA_PROVIDER=minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=lab-media
MINIO_USE_SSL=false
