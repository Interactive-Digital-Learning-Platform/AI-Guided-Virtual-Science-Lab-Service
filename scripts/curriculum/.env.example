# Most values are inherited from the lab service's ../../.env — only set here what differs.
# QDRANT_URL is required and is NOT in the lab .env.

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=pdf_knowledge_base
# QDRANT_API_KEY=

# --- retrieval (mirrors AI-Learning-Assistant-Service/app/core/config.py) ---
# EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
# EMBEDDING_DTYPE=q8                    # ONNX quantization: fp32|fp16|q8|q4
# EMBEDDING_BACKEND=transformers        # transformers (local, default) | nomic-api
# NOMIC_API_KEY=                        # only when EMBEDDING_BACKEND=nomic-api
# TOP_K_CHUNKS=8
# SCORE_THRESHOLD=0.4                   # below it → fall back to the single best hit
# RERANK_OVERFETCH=4                    # Qdrant pulls TOP_K_CHUNKS * this candidates

# --- inherited from ../../.env if present; override here only if needed ---
# MONGODB_URI=
# MONGODB_DB=
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b        # free tier ~8k tokens/min; the script retries on 429
